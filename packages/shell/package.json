{
  "name": "@antidraw/shell",
  "version": "0.0.2-alpha",
  "private": true,
  "license": "MIT",
  "description": "Electron shell for Antidraw",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "postinstall": "electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate --config ./src/main/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./src/main/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./src/main/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./src/main/db/drizzle.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.167.3",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "electron": "39.2.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.15.15",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@pierre/diffs": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.168.2",
    "@xyflow/react": "^12.10.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "^0.45.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "geist": "^1.7.0",
    "get-port": "^7.1.0",
    "hono": "^4.11.1",
    "lucide-react": "^0.562.0",
    "marked": "^17.0.1",
    "motion": "^12.38.0",
    "neverthrow": "^8.2.0",
    "npm": "^11.7.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.1",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.9"
  }
}
