---
import LandingHero from "@/components/islands/LandingHero"
import LandingIntro from "@/components/islands/LandingIntro"
import LandingUseCases from "@/components/islands/LandingUseCases"
import LandingFooter from "@/components/islands/LandingFooter"
import LandingWordmark from "@/components/islands/LandingWordmark"
import { PAGE_BG, SCROLL } from "@/components/user-components/AntidrawLandingCanvas"
import { fontStack } from "@/components/user-components/landing/LandingFonts"
import schibstedUrl from "@/components/user-components/landing/fonts/schibsted-grotesk.woff2?url"
import "@/styles/global.css"

const title = "Antidraw: the design canvas for your coding agents"
const description =
  "Antidraw is a product design and prototyping canvas for your coding agents, powered by real code. Bring your component library or design system, and design with components that actually work. Free and open source, for macOS."
const url = new URL("/", Astro.site).href
const image = new URL("/og.png", Astro.site).href
---

<html lang="en" style={`background-color: ${PAGE_BG.dark}; color-scheme: dark; scrollbar-color: ${SCROLL.dark} ${PAGE_BG.dark}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content={PAGE_BG.dark} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Antidraw" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Antidraw's canvas: product design & prototyping canvas for your coding agents, powered by real code." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={schibstedUrl} as="font" type="font/woff2" crossorigin />

    <!--
      The canvas's zoom, --k, before first paint: the server-rendered hero lays itself out from it
      (landing-canvas/canvas-landing.css), and keeps it current once hydrated. The same sum as its fitScale.
    -->
    <script is:inline>
      document.documentElement.style.setProperty("--k", String(Math.min(1.25, Math.max(0.55, Math.min(innerWidth / 1440, innerHeight / 900)))))
    </script>
  </head>
  <body>
    <!--
      Server-rendered whole, so the page shows before any script runs. Each part hydrates as its own island:
      the hero (canvas, title and navbar) as the page loads; the sections and footer as they come into view,
      so their code loads only then.
    -->
    <div class="antialiased" style={`background-color: ${PAGE_BG.dark}; color: #fff; font-family: ${fontStack("schibsted")}; --landing-page: ${PAGE_BG.dark}`}>
      <LandingHero client:load />
      <main class="px-5 sm:px-16">
        <LandingIntro client:visible={{ rootMargin: "400px" }} />
        <LandingUseCases client:visible={{ rootMargin: "400px" }} />
        <LandingFooter client:visible={{ rootMargin: "400px" }} />
      </main>
      <!-- The page signs off with the wordmark over the glowing columns, the full width of the page. Static: rendered to HTML, no script. -->
      <LandingWordmark />
    </div>

    <!--
      Cloudflare Web Analytics: cookieless page views and Core Web Vitals. Added by hand because Cloudflare's
      automatic injection skips responses a Worker serves, as this site's static assets are.
    -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "10930b0f22894b0e9dd1812143073bea"}'></script>
  </body>
</html>
