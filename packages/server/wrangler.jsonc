{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "antidraw-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  // nodejs_compat is required by better-auth (AsyncLocalStorage, node crypto).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Pinned so `npm run dev` matches BETTER_AUTH_URL and the Google OAuth
  // client's redirect URI (http://localhost:8799/api/auth/callback/google),
  // and stays clear of wrangler's default 8787 used by other Workers.
  "dev": {
    "port": 8799
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antidraw",
      // Replace after running:  npx wrangler d1 create antidraw
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "src/db/migrations"
    }
  ],
  // Publish + remix (README → Publish). Create both buckets before deploying:
  //   npx wrangler r2 bucket create antidraw-sites
  //   npx wrangler r2 bucket create antidraw-sources
  "r2_buckets": [
    // Public, served by packages/publish-worker as <slug>.antidraw.app.
    { "binding": "SITES", "bucket_name": "antidraw-sites" },
    // Private snapshots; clients only ever get short-lived signed URLs.
    { "binding": "SOURCES", "bucket_name": "antidraw-sources" }
  ],
  "vars": {
    "SITE_URL_TEMPLATE": "https://{slug}.antidraw.app",
    // Must match r2_buckets: presigned S3 URLs name the bucket.
    "SITES_BUCKET_NAME": "antidraw-sites",
    "SOURCES_BUCKET_NAME": "antidraw-sources"
    // STORAGE_MODE is never set here: only .dev.vars turns on the dev storage
    // route, so a deploy missing the R2_* secrets fails closed.
  },
  "ratelimits": [
    { "name": "PUBLISH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "REMIX_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Each complete HEADs every object of its session (up to 500) and lists
    // the site; a publish needs one, plus the app's few retries.
    { "name": "COMPLETE_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Nightly publish GC (src/scheduled.ts).
  "triggers": { "crons": ["17 3 * * *"] }
}
