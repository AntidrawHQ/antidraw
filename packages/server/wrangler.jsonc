{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "antidraw-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  // nodejs_compat is required by better-auth (AsyncLocalStorage, node crypto).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Pinned so `npm run dev` matches BETTER_AUTH_URL and the Google OAuth
  // client's redirect URI (http://localhost:8799/api/auth/callback/google),
  // and stays clear of wrangler's default 8787 used by other Workers.
  "dev": {
    "port": 8799
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antidraw",
      // Replace after running:  npx wrangler d1 create antidraw
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    // Published sites' files, under sites/<site id>/ (@antidraw/site-upload).
    // The site-serving Worker binds the same bucket.
    { "binding": "SITES", "bucket_name": "antidraw-sites" }
  ],
  "vars": {
    // A published site's share page, * being its slug: the canvas that shows
    // the site's components, which are served from <slug>.antidraw.app (see
    // @antidraw/site-worker). Overridden in .dev.vars for local development.
    "SHARE_URL_PATTERN": "https://antidraw.com/s/*"
  },
  "triggers": {
    // Hourly: clears what publishes leave behind, uploads never committed and
    // files the live version dropped (see cleanUpLeftovers in
    // services/site.service.ts).
    "crons": ["17 * * * *"]
  }
}
