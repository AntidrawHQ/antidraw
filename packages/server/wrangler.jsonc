{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "antidraw-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  // nodejs_compat is required by better-auth (AsyncLocalStorage, node crypto).
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Pinned so `npm run dev` matches BETTER_AUTH_URL and the Google OAuth
  // client's redirect URI (http://localhost:8799/api/auth/callback/google),
  // and stays clear of wrangler's default 8787 used by other Workers.
  "dev": {
    "port": 8799
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antidraw",
      // From `npx wrangler d1 create antidraw` (also in
      // @antidraw/site-worker's wrangler.jsonc, which shares it).
      "database_id": "0f1a9297-6b12-4031-8c3a-f2a7bf64f71e",
      // Local state (wrangler dev, --local migrations, tests) is kept under
      // this instead of database_id, so it doesn't move when the real id is
      // filled in, and the site Worker's `npm run dev` finds it.
      "preview_database_id": "antidraw-local",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    // Published sites' files, under sites/<site id>/ (@antidraw/site-upload).
    // The site-serving Worker binds the same bucket.
    { "binding": "SITES", "bucket_name": "antidraw-sites" }
  ],
  "artifacts": [
    // Each site's source, a git repo named site-<site id>
    // (src/services/source.service.ts). Artifacts has no local mode: `npm run
    // dev` uses the dev environment's namespace below, and tests run
    // src/test/wrangler.jsonc, which binds a stub.
    { "binding": "ARTIFACTS", "namespace": "sites", "remote": true }
  ],
  "flagship": [
    // Feature flags (src/lib/features.ts): `publish` gates every /api/sites
    // route. The site Worker binds the same app for `sites-serving`. Local
    // runs read wrangler's local flag store (see the README, Feature flags).
    { "binding": "FLAGS", "app_id": "9abbf580-f788-44c2-8676-4544595e70c9" }
  ],
  // Sites' preview images (src/services/preview.service.ts): a publish that
  // goes live is put on the queue, and this Worker, its consumer too, takes
  // the picture with Browser Run. One at a time: a picture is seconds of a
  // browser, and none is urgent. The queue is made once, by hand (see the
  // README, Deploy).
  "queues": {
    "producers": [{ "binding": "PREVIEWS", "queue": "antidraw-site-previews" }],
    "consumers": [
      { "queue": "antidraw-site-previews", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 2 }
    ]
  },
  "browser": { "binding": "BROWSER" },
  "vars": {
    // A published site's share page, * being its slug: the canvas that shows
    // the site's components, which are served from <slug>.antidraw.app (see
    // @antidraw/site-worker). Overridden in .dev.vars for local development.
    "SHARE_URL_PATTERN": "https://antidraw.com/s/*",
    // The API's public origin, which makes auth cookies Secure. Overridden in
    // .dev.vars for local development.
    "BETTER_AUTH_URL": "https://api.antidraw.com",
    // How long after a publish goes live its preview image is taken: the site
    // Worker takes up to 5 s to serve the new version.
    "PREVIEW_DELAY_SECONDS": "10"
  },
  "routes": [
    // Its own subdomain, not antidraw.com/api: the landing page and the share
    // pages keep antidraw.com, and the API's auth cookies stay off them.
    { "pattern": "api.antidraw.com", "custom_domain": true }
  ],
  "env": {
    // `npm run dev` (wrangler dev --env dev). D1 and R2 are local in dev
    // anyway; Artifacts is always remote, so dev gets its own namespace and
    // a local server can't make or hand out tokens for production's repos.
    // An environment doesn't inherit bindings or vars, so they're repeated
    // here, with the vars' local values (.dev.vars can still override them).
    // Never deployed, so it claims no route.
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "antidraw",
          "database_id": "0f1a9297-6b12-4031-8c3a-f2a7bf64f71e",
          "preview_database_id": "antidraw-local",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "SITES", "bucket_name": "antidraw-sites" }],
      "artifacts": [{ "binding": "ARTIFACTS", "namespace": "sites-dev", "remote": true }],
      "flagship": [{ "binding": "FLAGS", "app_id": "9abbf580-f788-44c2-8676-4544595e70c9" }],
      // Both local: the queue in wrangler's state, the browser a Chrome on
      // this machine, which can reach the share page's dev server.
      "queues": {
        "producers": [{ "binding": "PREVIEWS", "queue": "antidraw-site-previews" }],
        "consumers": [
          { "queue": "antidraw-site-previews", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 2 }
        ]
      },
      "browser": { "binding": "BROWSER" },
      "vars": {
        "SHARE_URL_PATTERN": "http://localhost:8786/s/*",
        "BETTER_AUTH_URL": "http://localhost:8799",
        "PREVIEW_DELAY_SECONDS": "10"
      },
      "routes": []
    }
  }
}
