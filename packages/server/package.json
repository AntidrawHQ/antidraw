{
  "name": "@antidraw/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Antidraw cloud API — a Cloudflare Worker (Hono + D1). The real, network-exposed backend that gates cloud operations (publish/sync) behind authenticated, authorized users. Distinct from the in-Electron API in @antidraw/shell.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply antidraw --local",
    "db:migrate": "wrangler d1 migrations apply antidraw --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "neverthrow": "^8.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.1",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3",
    "wrangler": "^4.105.0"
  }
}
