{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  // This package's Worker as tests run it (harness.ts): ../../wrangler.jsonc,
  // but with ARTIFACTS bound to a stub Worker (artifacts-stub/), since
  // Artifacts has no local mode. Keep the rest in step with that file.
  "name": "antidraw-server",
  "main": "../index.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antidraw",
      "database_id": "antidraw-local",
      "migrations_dir": "../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "antidraw-sites" }],
  "services": [{ "binding": "ARTIFACTS", "service": "artifacts-stub" }],
  "vars": {
    "SHARE_URL_PATTERN": "https://antidraw.com/s/*",
    "BETTER_AUTH_URL": "https://api.antidraw.com"
  }
}
