{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  // This package's Worker as tests run it (harness.ts): ../../wrangler.jsonc,
  // but with ARTIFACTS bound to a stub Worker (artifacts-stub/), since
  // Artifacts has no local mode, FLAGS to another (flags-stub/), so tests
  // set the flags, and BROWSER to a third (browser-stub/), so no test runs a
  // browser. Keep the rest in step with that file.
  "name": "antidraw-server",
  "main": "../index.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "antidraw",
      "database_id": "antidraw-local",
      "migrations_dir": "../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "antidraw-sites" }],
  "services": [
    { "binding": "ARTIFACTS", "service": "artifacts-stub" },
    { "binding": "FLAGS", "service": "flags-stub" },
    { "binding": "BROWSER", "service": "browser-stub" }
  ],
  "queues": {
    "producers": [{ "binding": "PREVIEWS", "queue": "antidraw-site-previews" }],
    "consumers": [
      { "queue": "antidraw-site-previews", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 2 }
    ]
  },
  "vars": {
    "SHARE_URL_PATTERN": "https://antidraw.com/s/*",
    "BETTER_AUTH_URL": "https://api.antidraw.com",
    // At once: nothing here serves the site.
    "PREVIEW_DELAY_SECONDS": "0"
  }
}
