{
  "name": "designsette",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/create-workspace/template"
  ],
  "scripts": {
    "dev:shell": "npm run dev -w @antidraw/shell",
    "dev:template": "npm run dev -w designsette-workspace",
    "build:shell": "npm run build -w @antidraw/shell",
    "build:template": "npm run build -w designsette-workspace",
    "build:create-workspace": "npm run build -w @antidrawapp/create-workspace",
    "build": "npm run build --workspaces --if-present"
  }
}
