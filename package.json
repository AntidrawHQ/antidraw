{
  "name": "antidraw",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/create-workspace/template"
  ],
  "scripts": {
    "dev:shell": "npm run dev -w @antidraw/shell",
    "dev:server": "npm run dev -w @antidraw/server",
    "deploy:server": "npm run deploy -w @antidraw/server",
    "dev:template": "npm run dev -w antidraw-workspace",
    "build:shell": "npm run build -w @antidraw/shell",
    "build:template": "npm run build -w antidraw-workspace",
    "build:create-workspace": "npm run build -w @antidrawapp/create-workspace",
    "build": "npm run build --workspaces --if-present",
    "runtime:local": "tsx scripts/use-local-runtime.ts",
    "runtime:npm": "tsx scripts/use-npm-runtime.ts"
  }
}
