    ["cn\\(([^)]*)\\)", "(?:'|\"|`)([^'\"``]*)(?:'|\"|`)"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^'\"``]*)(?:'|\"|`)"]
  ],
